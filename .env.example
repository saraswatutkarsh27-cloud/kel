# KEL IDE Environment Configuration

# Server
PORT=3000
HOSTNAME=localhost
NODE_ENV=development

# AI Provider API Keys (optional - can be set in the UI)
# At least one is needed for AI features
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# The workspace directory the IDE will open by default
# If not set, defaults to the project root
WORKSPACE_DIR=
